						{
							"_type": "UMLNoteView",
							"_id": "4c5469d716c64d02890fccc36e0ecb2f",
							"_parent": {
								"$ref": "4a9901f64e694626a46258e213c5ef21"
							},
							"lineColor": "#9A8C54",
							"fillColor": "#fffbe7",
							"fontColor": "#202020",
							"font": "Arial;13;0",
							"parentStyle": false,
							"showShadow": false,
							"left": 60,
							"top": 1451,
							"width": 578,
							"height": 135,
							"text": "Reglas de puntuación y constructores\nFutbolSala: victoria 3, empate 1, derrota 0. Baloncesto: victoria 2, derrota 1;\nrechaza empates. Cada subclase sobrescribe nombreDeporte, esMarcadorValido\ny calcularPuntos. Sus constructores llaman a super(a, b). Encuentro valida,\ncalcula ambos puntajes y solo entonces guarda el resultado y suma los puntos."
						},
